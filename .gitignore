# BTP Healthcare AI - Git Ignore

# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===========================================
# Virtual Environments
# ===========================================
venv/
ENV/
env/
.venv/

# ===========================================
# IDE & Editors
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ===========================================
# Jupyter Notebook
# ===========================================
.ipynb_checkpoints/

# ===========================================
# Reports & Documentation (Work in Progress)
# ===========================================
docs/*.tex
docs/*.pdf
docs/thesis/

# ===========================================
# Large Data Files (Too big for Git)
# ===========================================
data/raw/ChatDoctor/*.json
data/raw/ChatDoctor/*.csv
data/raw/MTS-Dialog/
datasets/unified/*.csv
datasets/*.csv

# ===========================================
# Excel Files
# ===========================================
*.xlsx
*.ipynb_checkpoints

# ===========================================
# Environment Variables
# ===========================================
.env
.env.local
.env.*.local
*.env

# ===========================================
# Data Files (Large)
# ===========================================
data/raw/mimic/
data/raw/*.csv
data/processed/*.csv
data/embeddings/*.pkl
data/embeddings/*.pt
*.csv
*.parquet
*.feather

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep

# ===========================================
# Model Weights (Large)
# ===========================================
models/ml/*.pkl
models/dl/*.pt
models/dl/*.pth
models/embeddings/
*.pkl
*.pt
*.pth
*.h5
*.onnx

# Keep directory structure
!models/ml/.gitkeep
!models/dl/.gitkeep

# ===========================================
# Logs
# ===========================================
logs/
*.log

# Keep directory structure
!logs/.gitkeep

# ===========================================
# Outputs
# ===========================================
outputs/reports/*.pdf
outputs/visualizations/*.png
outputs/visualizations/*.jpg
outputs/experiments/

# Keep directory structure
!outputs/reports/.gitkeep
!outputs/visualizations/.gitkeep
!outputs/experiments/.gitkeep

# ===========================================
# Testing
# ===========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ===========================================
# Documentation Build
# ===========================================
docs/_build/
site/

# ===========================================
# OS Files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================
# Secrets & Credentials
# ===========================================
*.pem
*.key
credentials.json
token.json
secrets/

# ===========================================
# Temporary Files
# ===========================================
tmp/
temp/
*.tmp
*.temp
*.bak

# ===========================================
# Docker
# ===========================================
.docker/

# ===========================================
# Misc
# ===========================================
*.zip
*.tar.gz
*.rar
