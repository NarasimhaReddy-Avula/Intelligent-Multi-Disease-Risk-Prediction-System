# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# API KEYS
# ===========================================

# OpenAI (for GPT-4 explanations)
OPENAI_API_KEY=sk-your-openai-api-key-here

# HuggingFace (for model downloads)
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# Groq (free LLM API alternative)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Together AI (another free option)
TOGETHER_API_KEY=your-together-api-key-here

# ===========================================
# DATABASE (Optional)
# ===========================================
DATABASE_URL=sqlite:///./data/btp_healthcare.db

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Environment: development, staging, production
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Web App Settings
STREAMLIT_PORT=8501

# ===========================================
# MODEL SETTINGS
# ===========================================

# LLM for explanations: gpt-4, gpt-3.5-turbo, llama-3-70b, mixtral-8x7b
LLM_MODEL=gpt-4

# Embedding model: pubmedbert, biobert, clinical-bert
EMBEDDING_MODEL=pubmedbert

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ===========================================
# MIMIC-III (PhysioNet)
# ===========================================
MIMIC_USERNAME=your-physionet-username
MIMIC_DATA_PATH=./data/raw/mimic/

# ===========================================
# DEPLOYMENT (Semester 2)
# ===========================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
